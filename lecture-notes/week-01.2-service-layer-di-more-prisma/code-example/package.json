{
  "name": "id608001-intermediate-app-dev-concepts",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "node --import tsx/esm node_modules/.bin/mocha",
    "test:coverage": "c8 node --import tsx/esm node_modules/.bin/mocha",
    "test:coverage:report": "c8 report --reporter=html && open coverage/index.html",
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint:check": "eslint .",
    "lint:fix": "eslint --fix .",
    "docker:run:dev": "docker run --name id608001-db-dev -e POSTGRES_PASSWORD=HelloWorld123 -p 5432:5432 -d postgres",
    "docker:run:test": "docker run --name id608001-db-test -e POSTGRES_PASSWORD=HelloWorld123 -p 5433:5432 -d postgres",
    "env:copy": "cp .env.example .env || copy .env.example .env",
    "env:test:copy": "cp .env.test.example .env || copy .env.test.example .env",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:reset": "npx prisma migrate reset --force",
    "prisma:seed-institutions": "node ./prisma/seeding/seed-institutions.js",
    "build:render": "npm install && npx prisma generate && npx prisma migrate deploy"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/chai": "^5.2.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.5.0",
    "@types/supertest": "^7.2.0",
    "c8": "^11.0.0",
    "chai": "^5.3.3",
    "dotenv": "^17.3.1",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.3.0",
    "mocha": "^11.7.5",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "prisma": "^6.12.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
